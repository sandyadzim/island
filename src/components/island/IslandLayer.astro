---
import type { SceneAsset } from "./scene-config";
import { STAGE } from "./scene-config";
import { registrationStyle } from "../../utils/scene-geometry";
import { SCENE_LIGHTS } from "./scene-lights";
import { SCENE_LANDMARKS } from './scene-landmarks';
interface Props {
  asset: SceneAsset;
}
const { asset } = Astro.props;
const landmark = SCENE_LANDMARKS.find((landmark) => landmark.assetId === asset.id);
const rim = asset.id === 'ASSET-05' || asset.id === 'ASSET-07';
// Chimney openings measured in the original full-canvas illustrations.
const smokeSource =
  asset.id === "ASSET-02"
    ? { x: 804, y: 257, phase: 0.5 }
    : asset.id === "ASSET-03"
      ? { x: 527, y: 282, phase: 0 }
      : undefined;
---

<div
  class="island-layer"
  data-asset-id={asset.id}
  data-destination={asset.destination}
  style={`z-index:${asset.zIndex};opacity:${asset.opacity};${registrationStyle(asset.registration, asset.pivot)}`}
>
  <div class="island-registration">
    <div class="island-parallax">
      <div class="island-ambient">
        <div class="island-interaction">
          <img
            src={asset.url}
            width={STAGE.width}
            height={STAGE.height}
            alt=""
            loading="eager"
            fetchpriority={asset.id === 'ASSET-00' || asset.id === 'ASSET-01' ? 'high' : 'low'}
            decoding="async"
            draggable="false"
          />
          {
            (SCENE_LIGHTS[asset.id] ?? []).map(
              ([x, y, width, height], index) => (
                <span
                  class:list={[
                    "scene-light-glow",
                    {
                      "lighthouse-lamp-glint":
                        asset.id === "ASSET-06" && index === 0,
                    },
                  ]}
                  data-lighthouse-glint={
                    asset.id === "ASSET-06" && index === 0 ? "" : undefined
                  }
                  aria-hidden="true"
                  style={`left:${(x / STAGE.width) * 100}%;top:${(y / STAGE.height) * 100}%;width:${(width / STAGE.width) * 100}%;height:${(height / STAGE.height) * 100}%;--light-duration:${7.3 + ((index * 7 + Number(asset.id.slice(-2))) % 11) * 0.47}s;--light-delay:${-((index * 1.73 + Number(asset.id.slice(-2)) * 2.19) % 13)}s;--light-direction:${index % 2 ? "reverse" : "normal"}`}
                />
              ),
            )
          }
          {landmark && <div class="landmark-warmth" aria-hidden="true">
            {rim ? <svg viewBox="0 0 1536 1024" fill="none" stroke="#ffdb96" stroke-width="10" stroke-linejoin="round">
              <defs><filter id={`warm-rim-${asset.id}`} x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="5" /></filter></defs>
              {landmark.polygons.map((polygon) => <polygon points={polygon.map(({x,y}) => `${x},${y}`).join(' ')} filter={`url(#warm-rim-${asset.id})`} />)}
            </svg> : (SCENE_LIGHTS[asset.id] ?? []).map(([x,y,width,height]) => <span class="landmark-warm-glow" style={`left:${x/STAGE.width*100}%;top:${y/STAGE.height*100}%;width:${width*1.6/STAGE.width*100}%;height:${height*1.6/STAGE.height*100}%`} />)}
          </div>}
          {
            smokeSource && (
              <div
                class="workshop-smoke"
                aria-hidden="true"
                style={`left:${(smokeSource.x / STAGE.width) * 100}%;top:${(smokeSource.y / STAGE.height) * 100}%`}
              >
                {Array.from({ length: 8 }, (_, index) => (
                  <span
                    class="workshop-smoke-puff"
                    style={`animation-delay:${-(index + smokeSource.phase)}s`}
                  >
                    <img
                      class="workshop-smoke-art"
                      src="/assets/island/workshop-smoke-puff.webp"
                      alt=""
                      width="512"
                      height="384"
                      decoding="async"
                      draggable="false"
                    />
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</div>
