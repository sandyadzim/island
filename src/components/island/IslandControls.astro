---
import { SCENE_ASSETS, STAGE, SCENE_HEADROOM } from './scene-config';
import { SCENE_LANDMARKS } from './scene-landmarks';
import { controlPolygon } from '../../utils/scene-geometry';
import { DESTINATIONS } from '../hero/destinations';
import HeroIcon from '../hero/HeroIcon.astro';
---

<nav
  class="island-controls"
  aria-label="Explore the island landmarks"
  data-island-controls
  inert
  aria-hidden="true"
>
  {SCENE_LANDMARKS.map((landmark) => {
    const asset = SCENE_ASSETS.find((asset) => asset.id === landmark.assetId)!;
    const destination = DESTINATIONS.find(
      (destination) => destination.id === landmark.destination,
    );
    const label = destination!.label;
    return (
      <a
        class="island-landmark-link"
        href={`/portfolio/#${landmark.destination}`}
        data-explore-destination={landmark.destination}
        data-landmark={landmark.destination}
        data-label-side={landmark.labelSide}
        aria-label={label}
        style={`z-index:${asset.zIndex};--marker-x:${landmark.marker.x}%;--marker-y:${landmark.marker.y}%`}
      >
        <svg
          class="landmark-hit-region"
          viewBox={`0 0 ${STAGE.width} ${STAGE.height + SCENE_HEADROOM}`}
          aria-hidden="true"
          focusable="false"
        >
          {landmark.polygons.map((polygon) => (
            <polygon points={controlPolygon(polygon, asset.registration)} />
          ))}
        </svg>
        <span class="landmark-marker" aria-hidden="true">
          <span class="landmark-disc">
            <HeroIcon name={destination!.icon} />
          </span>
          <span class="landmark-label">
            {label}
            <HeroIcon name="arrow" />
          </span>
        </span>
      </a>
    );
  })}
</nav>
