---
interface Props { name: string; }
const { name } = Astro.props;
const files: Record<string, string> = {
  'Vue.js': 'vue', 'Nuxt.js': 'nuxt', React: 'react', 'Next.js': 'next-js',
  JavaScript: 'javascript', TypeScript: 'typescript', HTML: 'html5', CSS: 'css-new',
  'Tailwind CSS': 'tailwind-css',
  'Element Plus': 'element-plus', 'shadcn/ui': 'shadcn-ui', Vuetify: 'vuetify',
  Bootstrap: 'bootstrap',
  Vitest: 'vitest', Jest: 'jest',
  'Node.js': 'node-js', 'Express.js': 'express-js', NestJS: 'nestjs',
  Angular: 'angular', Astro: 'astro', Bun: 'bun', Yarn: 'yarn', PHP: 'php',
  Sass: 'sass', Docker: 'docker', Git: 'git', PostgreSQL: 'postgresql',
  MongoDB: 'mongodb', MySQL: 'mysql', Nginx: 'nginx', Figma: 'figma',
  'React Native': 'react', Flutter: 'flutter', Swift: 'swift',
  Laravel: 'laravel', Golang: 'go',
};
const file = files[name];
if (!file) throw new Error(`Missing stack icon for ${name}`);
---
<img class="stack-icon" src={`/assets/stack-icons/${file}.svg`} width="32" height="32" alt="" aria-hidden="true" decoding="async" />
