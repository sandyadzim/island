---
import type { Destination } from "../island/scene-config";
import { EXPERIENCE } from "./portfolio-content";
import ProjectsContent from "./ProjectsContent.astro";
import AboutContent from "./AboutContent.astro";
import SkillsContent from "./SkillsContent.astro";
import HeroIcon from "../hero/HeroIcon.astro";
import "../../styles/portfolio-content.css";
interface Props {
  destination: Exclude<Destination, "home">;
}
const { destination } = Astro.props;
---

<div class:list={["destination-content", `content-${destination}`]}>
  {destination === "about" && <AboutContent />}
  {destination === "projects" && <ProjectsContent />}
  {destination === "skills" && <SkillsContent />}
  {
    destination === "experience" && (
      <>
        <p class="content-lead">
          A journey through products, teams, and frontend work.
        </p>
        <ol class="experience-list">
          {EXPERIENCE.map((job) => (
            <li>
              <p class="experience-date">{job.dates}</p>
              <h3>{job.organization}</h3>
              <p class="experience-role">{job.role}</p>
              <p>{job.detail}</p>
            </li>
          ))}
        </ol>
      </>
    )
  }
  {
    destination === "contact" && (
      <>
        <p class="content-lead">
          A little lighthouse for future conversations.
        </p>
        <p>
          Public contact details will be added here. For now, these rows are
          layout previews.
        </p>
        <dl class="contact-preview">
          <>
            <div>
              <>
                <dt>
                  <>
                    <HeroIcon name="mail" />
                    <span>Email</span>
                  </>
                </dt>
                <dd>
                  hello@example.com
                  <span>Sample address · not an active contact link</span>
                </dd>
              </>
            </div>
            <div>
              <>
                <dt>
                  <>
                    <HeroIcon name="arrow" />
                    <span>LinkedIn</span>
                  </>
                </dt>
                <dd>
                  Your LinkedIn profile
                  <span>Placeholder · profile link coming later</span>
                </dd>
              </>
            </div>
          </>
        </dl>
        <p class="content-note">
          Preview only. No messages can be sent from this section.
        </p>
      </>
    )
  }
</div>
