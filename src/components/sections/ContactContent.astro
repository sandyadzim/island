---
import HeroIcon from '../hero/HeroIcon.astro';
import '../../styles/contact-content.css';

// Email and location come from the supplied CV; profiles match the approved hero.
const email = 'sandy.adzim@gmail.com';
const profiles = [
  {
    name: 'LinkedIn',
    icon: 'linkedin',
    url: 'https://www.linkedin.com/in/sandy-rahmansyah/',
  },
  { name: 'GitHub', icon: 'github', url: 'https://github.com/sandyadzim' },
  {
    name: 'Instagram',
    icon: 'instagram-monochrome',
    url: 'https://www.instagram.com/rahmansyah_sandy',
  },
];
---

<div class="contact-layout">
  <h3 class="contact-title">Let’s start a conversation.</h3>
  <p class="contact-description">
    Have a website in mind, a frontend question, or a role you’d like to
    discuss? Tell me a little about it.
  </p>
  <ul class="contact-details" aria-label="Contact details">
    <li>
      <a
        class="contact-detail-card contact-email-card"
        href={`mailto:${email}`}
        aria-label={`Email Sandy at ${email}`}
      >
        <HeroIcon name="mail" />
        <span class="contact-detail-copy">
          <span class="contact-detail-label">Email</span>
          <span class="contact-detail-value">{email}</span>
        </span>
        <HeroIcon name="arrow-up-right" class="contact-email-arrow" />
      </a>
    </li>
    <li class="contact-detail-card">
      <HeroIcon name="map" />
      <span class="contact-detail-copy">
        <span class="contact-detail-label">Location</span>
        <span class="contact-detail-value">Jakarta, Indonesia</span>
      </span>
    </li>
  </ul>
  <p class="contact-social-copy">Find me online.</p>
  <div class="contact-socials" role="group" aria-label="Social media">
    {profiles.map((profile) => (
      <a
        class="contact-social-card"
        href={profile.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${profile.name} (opens in a new tab)`}
        title={profile.name}
      >
        <span
          class="contact-social-glyph"
          style={`--contact-social-icon: url('/assets/social-icons/${profile.icon}.svg')`}
          aria-hidden="true"
        />
      </a>
    ))}
  </div>
</div>
