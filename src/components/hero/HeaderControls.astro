---
import HeroIcon from './HeroIcon.astro';
---
<div class="hero-header-controls">
  <button class="hero-back-control" data-back-to-intro type="button" aria-label="Back to intro" title="Back to intro" hidden><HeroIcon name="arrow" /><span>Back to intro</span></button>
  <button class="hero-motion-control" data-water-motion-toggle type="button" aria-label="Pause motion" title="Pause motion" hidden>
    <HeroIcon name="pause" class="motion-icon-pause" />
    <HeroIcon name="play" class="motion-icon-play" />
    <span class="sr-only" data-motion-label>Pause motion</span>
  </button>
</div>
