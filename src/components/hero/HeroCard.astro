---
import HeroIcon from './HeroIcon.astro';
---
<section class="hero-card" aria-labelledby="hero-title">
  <p class="hero-eyebrow">A personal portfolio</p>
  <h1 id="hero-title">A little world.<br />A lot to explore.</h1>
  <div class="hero-divider" aria-hidden="true"></div>
  <p class="hero-introduction">Welcome to my corner of the internet. Explore my work, the things I know, and the story so far.</p>
  <a class="hero-primary-action" href="#guide-projects" data-guide-link>
    Start exploring <HeroIcon name="arrow" />
  </a>
  <p class="hero-footnote">Five places. One story.</p>
</section>
