---
import HeroIcon from "./HeroIcon.astro";

const socialProfiles = [
  {
    name: "LinkedIn",
    icon: "linkedin",
    url: "https://www.linkedin.com/in/sandy-rahmansyah/",
  },
  { name: "GitHub", icon: "github", url: "https://github.com/sandyadzim" },
  {
    name: "Instagram",
    icon: "instagram-monochrome",
    url: "https://www.instagram.com/rahmansyah_sandy",
  },
];
---

<section class="hero-card" aria-labelledby="hero-title" data-hero-card>
  <p class="hero-status">
    <span aria-hidden="true"></span>Frontend developer · 6+ years
  </p>
  <h1 id="hero-title">Hello!<br /> I'm Sandy.</h1>
  <p class="hero-introduction">
    Frontend developer who loves pixel-perfect details and smooth interactions,
    building polished websites where design and function work together.
  </p>
  <div class="hero-actions">
    <button class="hero-primary-action" data-start-exploring>
      <span>Explore the Island</span>
      <HeroIcon name="arrow" />
    </button>
    <a
      class="hero-secondary-action"
      href="/downloads/Sandy_Rahmansyah_CV.pdf"
      download="Sandy_Rahmansyah_CV.pdf"
      aria-label="Download CV"
      title="Download CV"
    >
      <HeroIcon name="download" />
    </a>
  </div>
  <div class="hero-socials" role="group" aria-label="Social profiles">
    {
      socialProfiles.map(({ name, icon, url }) => (
        <a
          class="hero-social"
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${name} (opens in a new tab)`}
          title={name}
        >
          <span
            class="hero-social-icon"
            style={`--social-icon: url('/assets/social-icons/${icon}.svg')`}
            aria-hidden="true"
          />
          <span>{name}</span>
        </a>
      ))
    }
  </div>
</section>
