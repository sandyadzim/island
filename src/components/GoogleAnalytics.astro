---
import { ANALYTICS } from '../config/analytics';
---

{import.meta.env.PROD && <script
  is:inline
  define:vars={{
    measurementId: ANALYTICS.measurementId,
    hosts: ANALYTICS.hosts,
  }}
>
  (() => {
    if (!hosts.includes(window.location.hostname)) return;

    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      // Google tag expects queued commands as Arguments objects.
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', measurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
    });

    let loaded = false;
    function loadAnalytics() {
      if (loaded) return;
      loaded = true;
      document.removeEventListener('visibilitychange', onVisibilityChange);
      const script = document.createElement('script');
      script.async = true;
      script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(script);
    }

    function scheduleAnalytics() {
      // Let first-party images and rendering finish before optional analytics.
      // The original timestamp and page-view config remain queued above.
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadAnalytics, { timeout: 1000 });
      } else {
        setTimeout(loadAnalytics, 0);
      }
    }

    function onVisibilityChange() {
      // Do not leave a short visit queued while the page is being backgrounded.
      if (document.visibilityState === 'hidden') loadAnalytics();
    }
    document.addEventListener('visibilitychange', onVisibilityChange);
    if (document.readyState === 'complete') scheduleAnalytics();
    else window.addEventListener('load', scheduleAnalytics, { once: true });
  })();
</script>}
