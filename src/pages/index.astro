---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import IslandScene from "../components/island/IslandScene.astro";
import HeroIdentity from "../components/hero/HeroIdentity.astro";
import HeaderControls from "../components/hero/HeaderControls.astro";
import HeroCard from "../components/hero/HeroCard.astro";
import HeroNavigation from "../components/hero/HeroNavigation.astro";
import IslandDestinationDialog from "../components/sections/IslandDestinationDialog.astro";
---

<PortfolioLayout>
  <HeroIdentity slot="identity" />
  <HeaderControls slot="header-controls" />
  <IslandScene />
  <HeroCard slot="card" />
  <HeroNavigation slot="menu" />
  <IslandDestinationDialog />
</PortfolioLayout>

<script>
  import { initHeroReveal } from '../scripts/hero-reveal';
  import { initIslandExplorer } from '../scripts/island-explorer';
  import { initIslandMusic } from '../scripts/island-music';
  let dispose: (() => void) | undefined;
  function initialize() {
    const root = document.querySelector<HTMLElement>('.portfolio-shell');
    if (root) {
      const disposeHero = initHeroReveal(root);
      const disposeExplorer = initIslandExplorer(root);
      const disposeMusic = initIslandMusic(root);
      dispose = () => { disposeHero(); disposeExplorer(); disposeMusic(); };
    }
  }
  initialize();
  window.addEventListener('pagehide', () => { dispose?.(); dispose = undefined; });
  window.addEventListener('pageshow', (event) => { if (event.persisted) initialize(); });
</script>
