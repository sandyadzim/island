---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A quiet island scene at dusk, built from layered artwork." />
    <title>Island Portfolio</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to the island</a>
    <div class="portfolio-shell">
      <header class="layout-header" data-layout-slot="header">
        <h1 class="sr-only">Island Portfolio</h1>
        <div class="layout-identity"><slot name="identity" /></div>
        <div class="layout-controls"><slot name="header-controls" /></div>
      </header>
      <main id="main" tabindex="-1" class="layout-main">
        <slot />
        <div class="layout-card" data-layout-slot="card"><slot name="card" /></div>
      </main>
      <footer class="layout-menu" data-layout-slot="menu">
        <slot name="menu" />
      </footer>
    </div>
  </body>
</html>
